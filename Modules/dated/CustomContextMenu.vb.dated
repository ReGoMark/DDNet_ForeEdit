Public Class CustomContextMenu
    Inherits ToolStripProfessionalRenderer

    Private ReadOnly BgBrush As New SolidBrush(Color.White)
    Private ReadOnly HoverBrush As New SolidBrush(Color.FromArgb(230, 230, 230))
    Private ReadOnly BorderPen As New Pen(Color.FromArgb(200, 200, 200))
    Private ReadOnly SeparatorPen As New Pen(Color.FromArgb(210, 210, 210))

    ' 整个菜单背景（含图标列）
    Protected Overrides Sub OnRenderToolStripBackground(e As ToolStripRenderEventArgs)
        e.Graphics.FillRectangle(BgBrush, e.AffectedBounds)
    End Sub

    ' 图标列背景（覆盖默认的灰色）
    Protected Overrides Sub OnRenderImageMargin(e As ToolStripRenderEventArgs)
        e.Graphics.FillRectangle(BgBrush, e.AffectedBounds)
    End Sub

    ' 菜单边框
    Protected Overrides Sub OnRenderToolStripBorder(e As ToolStripRenderEventArgs)
        Dim r = New Rectangle(0, 0, e.ToolStrip.Width - 1, e.ToolStrip.Height - 1)
        e.Graphics.DrawRectangle(BorderPen, r)
    End Sub

    ' 选中项背景
    Protected Overrides Sub OnRenderMenuItemBackground(e As ToolStripItemRenderEventArgs)
        If e.Item.Selected AndAlso e.Item.Enabled Then
            e.Graphics.FillRectangle(HoverBrush, New Rectangle(Point.Empty, e.Item.Size))
        Else
            e.Graphics.FillRectangle(BgBrush, New Rectangle(Point.Empty, e.Item.Size))
        End If
    End Sub

    ' 分割线
    Protected Overrides Sub OnRenderSeparator(e As ToolStripSeparatorRenderEventArgs)
        Dim y = e.Item.Height \ 2
        Dim left = 8    ' 左边距
        Dim right = 8   ' 右边距
        e.Graphics.DrawLine(SeparatorPen, left, y, e.Item.Width - right, y)
    End Sub
End Class
