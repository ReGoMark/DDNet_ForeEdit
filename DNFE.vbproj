  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Icons.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Icons.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Icons.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Icons.Designer.vb</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\changelogs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\library.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\hotkeys.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\SarasaMonoSlabSC-Regular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\standard\DejaVuSans.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\standard\Font_Awesome_6_Free-Solid-900.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\standard\GlowSansJ-Compressed-Book.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\standard\index.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\standard\SourceHanSans.ttc">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <CustomToolNamespace>My</CustomToolNamespace>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
  </PropertyGroup>

  <!-- Debug: only read version.txt. Release: recompute (YY+half . MMdd . counter) and write back. -->
  <Target Name="AutoVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_Cur>2602.1023.152</_Cur>
      <_Cur Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</_Cur>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <_YY>$([System.DateTime]::Now.ToString('yy'))</_YY>
      <_Half>01</_Half>
      <_Half Condition="$([System.DateTime]::Now.Month) &gt; 6">02</_Half>
      <_MD>$([System.DateTime]::Now.ToString('MMdd'))</_MD>
      <_Cnt>$([MSBuild]::Add($(_Cur.Split('.')[2]), 1))</_Cnt>
    </PropertyGroup>

    <!-- Locate git: PATH first, then the copy bundled with Visual Studio, then Git for Windows -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <_GitExe>git</_GitExe>
      <_GitExe Condition="Exists('$(DevEnvDir)CommonExtensions\Microsoft\TeamFoundation\Team Explorer\Git\cmd\git.exe')">$(DevEnvDir)CommonExtensions\Microsoft\TeamFoundation\Team Explorer\Git\cmd\git.exe</_GitExe>
      <_GitExe Condition="Exists('$(ProgramFiles)\Git\cmd\git.exe')">$(ProgramFiles)\Git\cmd\git.exe</_GitExe>
    </PropertyGroup>

    <!-- Release: count git changes (same number as VS bottom-right); falls back to +1 if git is unavailable -->
    <Exec Condition="'$(Configuration)' == 'Release'" Command="&quot;$(_GitExe)&quot; status --porcelain -uall" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitLines" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <_Cnt Condition="'$(_GitExit)' == '0'">@(_GitLines-&gt;Count())</_Cnt>
      <_Cur>$(_YY)$(_Half).$(_MD).$(_Cnt)</_Cur>
    </PropertyGroup>
    <Message Importance="high" Text="AutoVersion: config=$(Configuration), git=$(_GitExe), git exit=$(_GitExit), git changes=@(_GitLines-&gt;Count()), version=$(_Cur)" />
    <WriteLinesToFile File="$(VersionFile)" Lines="$(_Cur)" Overwrite="true" Condition="'$(Configuration)' == 'Release'" />

    <PropertyGroup>
      <Version>$(_Cur)</Version>
      <AssemblyVersion>$(_Cur)</AssemblyVersion>
      <FileVersion>$(_Cur)</FileVersion>
    </PropertyGroup>
  </Target>

</Project>